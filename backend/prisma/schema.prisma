// Prisma Schema for KrishiSaathi Backend

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// FARMERS TABLE
// ============================================
model Farmer {
  id                  String         @id @default(uuid())
  name                String         @db.Text
  phoneNumber         String         @unique
  preferredLanguage   Language       @default(ENGLISH)

  registrationDate    DateTime       @default(now())
  lastLogin           DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  farmerCrops         FarmerCrop[]
  chatHistory         ChatHistory[]  @relation("FarmerToChats")
  chatSessions        ChatSession[]  @relation("FarmerToSessions")   // ← NEW
  farmerSessions      FarmerSession[]
  locations           FarmerLocation[]
  harvestRecords      HarvestRecord[]

  @@map("farmers")
}

// ============================================
// FARMERS LOCATION
// ============================================
model FarmerLocation {
  id           String   @id @default(uuid())
  farmerId     String
  locationName String
  latitude     Float
  longitude    Float

  address      String?
  village      String?
  area         String?
  district     String?
  state        String?
  pincode      String?

  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now())

  farmer       Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  crops        FarmerCrop[]     @relation("LocationCrops")
  chats        ChatHistory[]    @relation("LocationChats")
  chatSessions ChatSession[]    @relation("LocationSessions")         // ← NEW
  weather      WeatherData[]
  forecasts    WeatherForecast[]
  harvestRecords HarvestRecord[]

  @@map("farmer_locations")
}

// ============================================
// CHAT SESSION TABLE (NEW)
// Groups messages into named conversations
// ============================================
model ChatSession {
  id            String      @id @default(uuid())
  farmerId      String
  locationId    String
  title         String
  chatType      ChatType    @default(GENERAL)
  cropName      String?
  sowingDate    DateTime?
  pinnedMessage String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  farmer      Farmer         @relation("FarmerToSessions", fields: [farmerId], references: [id], onDelete: Cascade)
  location    FarmerLocation @relation("LocationSessions", fields: [locationId], references: [id], onDelete: Cascade)
  messages    ChatHistory[]  @relation("SessionChats")

  @@map("chat_sessions")
  @@index([farmerId, locationId])
}

// ============================================
// WEATHER DATA TABLE
// ============================================
model WeatherData {
  id              String   @id @default(uuid())
  locationId      String
  temperature     Float
  feelsLike       Float
  humidity        Int
  windSpeed       Float
  weatherMain     String
  weatherDesc     String
  weatherIcon     String
  pressure        Int?
  visibility      Int?
  cloudiness      Int?
  sunrise         DateTime?
  sunset          DateTime?
  fetchedAt       DateTime @default(now())
  location        FarmerLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@map("weather_data")
  @@index([locationId])
  @@unique([locationId])
}

// ============================================
// WEATHER FORECAST TABLE
// ============================================
model WeatherForecast {
  id              String   @id @default(uuid())
  locationId      String
  date            DateTime
  tempMin         Float
  tempMax         Float
  weatherMain     String
  weatherDesc     String
  weatherIcon     String
  humidity        Int
  windSpeed       Float
  chanceOfRain    Float?
  fetchedAt       DateTime @default(now())
  location        FarmerLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@map("weather_forecast")
  @@index([locationId, date])
}

// ============================================
// CROPS MASTER TABLE
// ============================================
model CropMaster {
  id                    String          @id @default(uuid())
  cropNameEn            String
  cropNameHi            String?
  cropNameBn            String?
  suitableClimate       Climate
  waterRequirement      WaterRequirement
  growingDurationDays   Int
  descriptionEn         String?         @db.Text
  descriptionHi         String?         @db.Text
  descriptionBn         String?         @db.Text
  createdAt             DateTime        @default(now())
  farmerCrops           FarmerCrop[]
  weatherPrecautions    WeatherPrecaution[]
  coldStorageCrops      ColdStorageCrop[]

  @@map("crops_master")
}

// ============================================
// FARMER CROPS TABLE
// ============================================
model FarmerCrop {
  id                  String       @id @default(uuid())
  farmerId            String
  locationId          String
  cropId              String
  sowingDate          DateTime
  expectedHarvestDate DateTime?
  status              CropStatus   @default(GROWING)
  createdAt           DateTime     @default(now())
  farmer              Farmer       @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  location            FarmerLocation @relation("LocationCrops", fields: [locationId], references: [id], onDelete: Cascade)
  crop                CropMaster   @relation(fields: [cropId], references: [id])
  harvestRecords      HarvestRecord[]

  @@map("farmer_crops")
}

model HarvestRecord {
  id              String   @id @default(uuid())
  farmerId        String
  locationId      String
  farmerCropId    String
  quantity        Float
  harvestDate     DateTime @default(now())
  notes           String?  @db.Text
  farmer          Farmer         @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  location        FarmerLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  farmerCrop      FarmerCrop     @relation(fields: [farmerCropId], references: [id])

  @@map("harvest_records")
  @@index([farmerId, locationId])
  @@index([farmerCropId])
}

model ColdStorage {
  id            String   @id @default(uuid())
  name          String
  nameBn        String?
  nameHi        String?
  registeredUnder String  @map("ownerName")
  ownerContact  String
  latitude      Float
  longitude     Float
  address       String
  district      String
  state         String
  capacity      Int
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  storedCrops   ColdStorageCrop[]

  @@map("cold_storages")
  @@index([latitude, longitude])
  @@index([district, state])
}

model ColdStorageCrop {
  id              String   @id @default(uuid())
  coldStorageId   String
  cropId          String
  coldStorage     ColdStorage @relation(fields: [coldStorageId], references: [id], onDelete: Cascade)
  crop            CropMaster  @relation(fields: [cropId], references: [id])

  @@unique([coldStorageId, cropId])
  @@map("cold_storage_crops")
  @@index([coldStorageId])
  @@index([cropId])
}

model WeatherPrecaution {
  id                String           @id @default(uuid())
  cropId            String
  weatherCondition  WeatherCondition
  precautionTextEn  String           @db.Text
  precautionTextHi  String?          @db.Text
  precautionTextBn  String?          @db.Text
  crop              CropMaster       @relation(fields: [cropId], references: [id])

  @@map("weather_precautions")
}

// ============================================
// CHAT HISTORY TABLE
// ============================================
model ChatHistory {
  id              String    @id @default(uuid())
  farmerId        String
  messageText     String    @db.Text
  messageLanguage Language
  isFarmerMessage Boolean
  timestamp       DateTime  @default(now())
  locationId      String
  sessionId       String?   // links to ChatSession (nullable for old records)

  farmer          Farmer         @relation("FarmerToChats", fields: [farmerId], references: [id], onDelete: Cascade)
  location        FarmerLocation @relation("LocationChats", fields: [locationId], references: [id], onDelete: Cascade)
  session         ChatSession?   @relation("SessionChats", fields: [sessionId], references: [id], onDelete: SetNull)

  @@map("chat_history")
  @@index([sessionId])
}

// ============================================
// SESSION MANAGEMENT TABLE
// ============================================
model FarmerSession {
  id            String   @id @default(uuid())
  sessionId     String   @unique
  farmerId      String
  deviceInfo    String?
  intakeStep    Int?
  intakeData    Json?
  createdAt     DateTime @default(now())
  lastAccessed  DateTime @updatedAt
  farmer        Farmer   @relation(fields: [farmerId], references: [id], onDelete: Cascade)

  @@map("farmer_sessions")
}

// ============================================
// ENUMS
// ============================================
enum Language {
  ENGLISH
  BENGALI
  HINDI
}

enum ChatType {
  CROP
  GENERAL
}

enum Climate {
  SUMMER
  WINTER
  MONSOON
  ALL_SEASON
}

enum WaterRequirement {
  LOW
  MEDIUM
  HIGH
}

enum CropStatus {
  SOWING
  GROWING
  HARVESTED
}

enum WeatherCondition {
  CLEAR
  RAIN
  DROUGHT
  HEATWAVE
  COLD
  STORM
  CLOUDY
}
